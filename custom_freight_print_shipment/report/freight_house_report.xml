<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- FORMATO -->
    <record id="paperformat_shipping_house" model="report.paperformat">
        <field name="name">Format House Instruction</field>
        <field name="default" eval="False"/>
        <field name="format">Letter</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">10</field>
        <field name="margin_bottom">20</field>
        <field name="margin_left">10</field>
        <field name="margin_right">10</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">0</field>
        <field name="dpi">95</field>
    </record>


    <!-- REPORTE -->

    <record id="action_report_freight_house" model="ir.actions.report">
        <field name="name">SHIPMENT INSTRUCTION</field>
        <field name="model">freight.operation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">custom_freight_print_shipment.report_freight_house_document</field>
        <field name="report_file">custom_freight_print_shipment.report_freight_house_document</field>
        <field name="print_report_name">'Shipment_%s' % (object.name)</field>
        <field name="binding_model_id" eval="False"/>
        <field name="paperformat_id" ref="paperformat_shipping_house"/>
    </record>


    <!-- PLANTILLA PRINCIPAL -->
    <template id="report_freight_house_document">

        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="doc">

                <t t-call="web.basic_layout">

                    <div class="page arrival-container">

                        <div class="oe_structure"/>


                        <!-- LOGO -->

                        <table class="arrival-logo-table">
                            <tr>
                                <td class="arrival-logo-cell">
                                    <div class="arrival-logo-box">
                                        <img t-att-src="'/custom_freight_print_shipment/static/src/css/img/Encabezado_incargo.jpeg'" class="arrival-logo-img" />
                                    </div>
                                </td>
                            </tr>
                        </table>

                        <!-- TITLE -->

                        <t t-if="doc.transport == 'ocean'">

                            <table class="arrival-main-title-table">

                                <tr>

                                    <td class="title-cell-left">
                                        <h1 class="arrival-main-title">
                                            Sea Freight FCL Arrival Notice
                                        </h1>
                                    </td>

                                    <td class="title-cell-right">
                                        <span class="arrival-page-counter">
                                            Page 1 of 1
                                        </span>
                                    </td>

                                </tr>

                            </table>

                        </t>


                        <table class="arrival-table">

                            <tr>

                                <!-- DIRECCIÓN -->

                                <td class="arrival-main-address">

                                    <span class="field-value">
                                        THE IMPORT MANAGER<br/>
                                        ADMBIO PRODUCTOS SA DE CV<br/>
                                        KM<br/>
                                        BOULEVARD MIGUEL ALEMAN KM 1140<br/>
                                        GOMEZ PALACIO CENTRO<br/>
                                        GOMEZ PALACIO DUR 35000
                    </span>

                </td>


                <!-- SHIPMENT -->

                <td class="shipment-info-container">

                    <table class="shipment-info-table">

                        <tr>

                            <td class="shipment-label">
                                                SHIPMENT
                            </td>

                            <td class="shipment-value">
                                <span t-field="doc.name" class="shipment-name-value" />
                            </td>

                        </tr>


                        <tr>

                            <td class="shipment-label">
                                                CONSOL
                            </td>

                            <td class="shipment-value">
                                                C2600005555
                            </td>

                        </tr>


                        <tr>

                            <td class="shipment-label-last">
                                                DATE
                            </td>

                            <td class="shipment-value-last">

                                <span t-field="doc.date_create_shipment" t-options="{'format': 'dd-MMM-yy'}" />

                            </td>

                        </tr>

                    </table>

                </td>

            </tr>

        </table>


        <!-- SHIPPER / CONSIGNEE -->

        <table class="arrival-table partner-table">

            <tr>

                <!-- SHIPPER -->

                <td class="shipper-column">

                    <div class="partner-box">

                        <strong class="partner-title">
                                            SHIPPER:
                        </strong>

                        <br/>

                        <div t-if="doc.shipper_id" t-field="doc.shipper_id" t-options="{'widget': 'contact', 'fields': ['name', 'address'], 'no_marker': True}" />

                    </div>

                </td>

                <!-- CONSIGNEE -->

                <td class="consignee-column">

                    <div class="partner-box">

                        <strong class="partner-title">
                                            CONSIGNEE:
                        </strong>

                        <br/>

                        <div t-if="doc.consignee_id" t-field="doc.consignee_id" t-options="{'widget': 'contact', 'fields': ['name', 'address'], 'no_marker': True}" />

                    </div>

                </td>

            </tr>

        </table>


        <!-- RELEASE TYPE / COMMODITY -->

        <table class="arrival-table">

            <tr>

                <td class="release-column">

                    <span class="field-label">
                                        Release Type
                    </span>

                    <span class="field-value" t-field="doc.release_type" />

                </td>


                <td class="commodity-column">

                    <span class="field-label">
                                        Commodity Type
                    </span>

                    <span class="field-value">
                                        GEN (General)
                    </span>

                </td>

            </tr>


            <tr>

                <td class="carrier-column">

                    <span class="field-label">
                                        Carrier
                    </span>

                    <span class="field-value" t-field="doc.shipping_line_id.name" />

                </td>


                <td class="carrier-column">

                    <span class="field-label">
                                        GOODS TO BE CLEARED BY
                    </span>

                    <span class="field-value" t-field="doc.agent_id.name" />

                </td>

            </tr>

        </table>


        <!--REFERENCIAS / BILL OF LADING -->

        <table class="arrival-table">

            <tr>

                <td class="reference-column">

                    <span class="field-label">
                                        Order Numbers / Reference
                    </span>

                    <span class="field-value"/>

                </td>


                <td class="carrier-column">

                    <span class="field-label">
                                        OCEAN BILL OF LADING
                    </span>

                    <span class="field-value" t-field="doc.obl" />

                </td>


                <td class="house-bl-column">

                    <span class="field-label">
                                        House Bill of Lading
                    </span>

                    <span class="field-value">
                                        PKGHX02688881
                    </span>

                </td>

            </tr>

        </table>


        <!-- GOODS DESCRIPTION -->

        <table class="arrival-table">

            <tr>

                <td class="section-banner-td">
                                    GOODS DESCRIPTION
                </td>

            </tr>

            <tr>

                <td class="goods-description-cell">

                    <span class="field-value goods-description-value" t-field="doc.note" />

                </td>

            </tr>

        </table>


        <!-- TABLE PACKAGES -->

        <table class="arrival-table">

            <tr>

                <!-- PACKAGES -->

                <td class="metric-packages">

                    <span class="field-label">
                                        Packages
                    </span>

                    <span class="field-value metric-value">

                        <t t-if="doc.report_package_ids">

                            <span t-out="sum(doc.report_package_ids.mapped('quantity'))" />

                            <span t-out="doc.report_package_ids[0].package_id.name if doc.report_package_ids[0].package_id else 'PKG'" />

                        </t>

                        <t t-else="">
                                            0 
                        </t>

                    </span>

                </td>

                <!-- WEIGHT -->

                <td class="metric-column">

                    <span class="field-label">
                                        Weight
                    </span>

                    <span class="field-value metric-value">

                        <t t-if="doc.report_package_ids">

                            <span t-out="sum(doc.report_package_ids.mapped('gross_weight'))" />

                        </t>

                        <t t-else="">
                                            0.00
                        </t>

                    </span>

                </td>
                <!-- VOLUME -->

                <td class="metric-column">

                    <span class="field-label">
                                        Volume
                    </span>

                    <span class="field-value metric-value">

                        <t t-if="doc.report_package_ids">

                            <span t-out="sum(doc.report_package_ids.mapped('volume'))" />

                        </t>

                        <t t-else="">
                                            0.00 
                        </t>

                    </span>

                </td>


                <!-- CHARGEABLE -->

                <td class="metric-column">

                    <span class="field-label">
                                        Chargeable
                    </span>

                    <span class="field-value metric-value">

                        <t t-if="doc.report_package_ids">

                            <span t-out="sum(doc.report_package_ids.mapped('volume'))" />

                        </t>

                        <t t-else="">
                                            0.00 
                        </t>

                    </span>

                </td>


                <!-- EST DELIVERY -->

                <td class="metric-column">

                    <span class="field-label">
                                        Est Delivery
                    </span>

                    <span class="field-value"/>

                </td>

            </tr>

        </table>


        <!-- ORIGEN / DESTINO / FECHAS -->

        <table class="arrival-table">

            <tr>

                <!-- GOODS COLLECTED FROM -->

                <td class="goods-collected-column">

                    <span class="field-label">
                                        Goods Collected From
                    </span>

                    <span class="field-value" t-field="doc.loading_port_id.name" />

                </td>


                <!-- ETD -->

                <td class="etd-column">

                    <span class="field-label">
                                        ETD
                    </span>

                    <span class="field-value">
                                        27-Jan-26
                    </span>

                </td>


                <!-- GOODS DELIVERED TO -->

                <td class="goods-delivered-column">

                    <span class="field-label">
                                        Goods Delivered To
                    </span>

                    <span class="field-value" t-field="doc.discharge_port_id.name" />

                </td>


                <!-- ETA -->

                <td class="eta-column">

                    <span class="field-label">
                                        ETA
                    </span>

                    <span class="field-value">
                                        07-Mar-26
                    </span>

                </td>

            </tr>

        </table>


        <!-- ROUTING INFORMATION -->

        <table class="arrival-table">

            <tr>

                <td class="section-banner-td">
                                    ROUTING INFORMATION
                </td>

            </tr>

        </table>


        <!-- TABLE DE ROUTING -->

        <table class="arrival-table routing-table">

            <tr class="routing-header">

                <td class="routing-mode">
                                    Mode
                </td>

                <td class="routing-vessel">
                                    Vessel / Voyage / IMO
                </td>

                <td class="routing-carrier">
                                    Carrier
                </td>

                <td class="routing-load">
                                    Load
                </td>

                <td class="routing-discharge">
                                    Disch.
                </td>

                <td class="routing-etd">
                                    ETD
                </td>

                <td class="routing-eta">
                                    ETA
                </td>

                <td class="routing-atd">
                                    ATD
                </td>

                <td class="routing-ata">
                                    ATA
                </td>

            </tr>

            <t t-if="doc.freight_route_ids">

                <t t-foreach="doc.freight_route_ids" t-as="route_line">

                    <tr>

                        <!-- MODE -->

                        <td class="routing-mode">

                            <span t-field="route_line.transport" />

                        </td>


                        <!-- VESSEL / VOYAGE / IMO -->

                        <td class="routing-vessel">

                            <span t-if="route_line.vessel_id" t-field="route_line.vessel_id.name" />

                            <span t-elif="doc.vessel_id" t-field="doc.vessel_id.name" />

                        </td>


                        <!-- CARRIER -->

                        <td class="routing-carrier">

                            <span class="field-value" t-field="doc.shipping_line_id.name" />

                        </td>


                        <!-- LOAD -->

                        <td class="routing-load">

                            <span t-if="route_line.loading_port_id" t-field="route_line.loading_port_id.name" />

                        </td>


                        <!-- DISCHARGE -->

                        <td class="routing-discharge">

                            <span t-if="route_line.discharge_port_id" t-field="route_line.discharge_port_id.name" />

                        </td>


                        <!-- ETD -->

                        <td class="routing-etd">

                            <span t-field="route_line.etd" t-options="{'widget': 'date'}" />

                        </td>


                        <!-- ETA -->

                        <td class="routing-eta">

                            <span t-field="route_line.eta" t-options="{'widget': 'date'}" />

                        </td>


                        <!-- ATD -->

                        <td class="routing-atd">

                            <span t-field="route_line.atd" t-options="{'widget': 'date'}" />

                        </td>


                        <!-- ATA -->

                        <td class="routing-ata">

                            <span t-field="route_line.ata" t-options="{'widget': 'date'}" />

                        </td>

                    </tr>

                </t>

            </t>

        </table>


        <!--  DETALLE DE CONTENEDORES -->

        <table class="arrival-table container-table">

            <thead>

                <tr class="container-header">

                    <td class="container-column">
                                        CONTAINER
                    </td>

                    <td class="seal-column">
                                        SEAL
                    </td>

                    <td class="type-column">
                                        TYPE
                    </td>

                    <td class="weight-column">
                                        WEIGHT
                    </td>

                    <td class="volume-column">
                                        VOLUME
                    </td>

                    <td class="packs-column">
                                        PACK
                    </td>

                </tr>

            </thead>


            <tbody>

                <t t-set="ordenes" t-value="doc.freight_order_ids" />


                <!-- ÓRDENES -->

                <t t-if="ordenes">

                    <t t-foreach="ordenes" t-as="order_line">

                        <tr>

                            <!-- CONTAINER -->

                            <td class="container-column">

                                <span t-field="order_line.description" />

                            </td>


                            <!-- SEAL -->

                            <td class="seal-column">

                                <t t-if="doc.report_package_ids">

                                    <span t-out="', '.join(doc.report_package_ids.mapped('carrier_seal') if doc.report_package_ids.mapped('carrier_seal') else []) or '-'" />

                                </t>

                                <t t-else="">
                                                    -
                                </t>

                            </td>


                            <!-- TYPE -->

                            <td class="type-column">

                                <span t-if="order_line.package_id" t-field="order_line.package_id.name" />

                            </td>


                            <!-- WEIGHT -->

                            <td class="weight-column">

                                <span t-field="order_line.gross_weight" />

                            </td>


                            <!-- VOLUME -->

                            <td class="volume-column">

                                <span t-field="order_line.volume" />

                            </td>


                            <!-- PACK -->

                            <td class="packs-column">

                                <span t-out="int(order_line.quantity) if order_line.quantity else 0" />

                            </td>

                        </tr>

                    </t>

                </t>
                <t t-if="not ordenes">

                    <tr>

                        <td colspan="6" class="text-center text-muted container-empty-cell">
                                            No container information available
                        </td>

                    </tr>

                </t>

            </tbody>

        </table>


        <!-- FOOTER -->

        <div class="arrival-footer">

            <table class="arrival-footer-table">

                <tr>

                    <td class="arrival-footer-cell">

                        <div class="arrival-footer-box">

                            <img t-att-src="'/custom_freight_print_shipment/static/src/css/img/Pie_pagina_incargo.png'" class="arrival-footer-img" />

                        </div>

                    </td>

                </tr>

            </table>

        </div>

    </div>

</t>

</t>

</t>

</template>

</odoo>
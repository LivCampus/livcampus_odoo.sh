<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_freight_booking_form_inherit" model="ir.ui.view">
        <field name="name">freight.booking.form.inherit</field>
        <field name="model">freight.booking</field>
        <field name="inherit_id" ref="bi_freight_management.freight_booking_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_convert_shipment']" position="after">
                <button name="action_button_printreport_freight" type="object" string="Imprimir" icon="fa-print" class="btn-secondary"/>
                <button name="action_button_print_quotation" type="object" string="Imprimir Cotización" icon="fa-file-pdf-o" class="btn-secondary"/>
            </xpath>

            <xpath expr="//field[@name='shipper_id']" position="before">
                <field name="customer_id"/>
            </xpath>

            <xpath expr="//field[@name='consignee_id']" position="after">
                <field name="intructions_hbl" invisible="transport != 'ocean'"/>
            </xpath>

            <xpath expr="//field[@name='booking_line_ids']//list/field[@name='price_unit']" position="after">
                <field name="currency_id"/>
            </xpath>

            <xpath expr="//field[@name='mawb_no']" position="after">
                <field name="mbl_destination" invisible="transport != 'air'"/>
            </xpath>

            <xpath expr="//field[@name='date']" position="after">
                <field name="etd_date"/>
            </xpath>

            <xpath expr="//field[@name='etd_date']" position="after">
                <field name="house_number"/>
            </xpath>

            <xpath expr="//field[@name='agent_id']" position="after">
                <field name="commodity"/>
            </xpath>

            <xpath expr="//field[@name='freight_pc_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//field[@name='freight_other_pc_id']" position="replace">
                <field name="freight_payable" widget="selection"/>
            </xpath>

            <xpath expr="//field[@name='house_number']" position="after">
                <field name="quote_validity_date"/>
            </xpath>

            <xpath expr="//field[@name='booking_line_ids']" position="before">
                <group>
                    <field name="add_total"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
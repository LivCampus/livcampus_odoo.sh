        <field name="name">Freight Order Package Item: multi-company</field>
        <field name="model_id" ref="bi_freight_management.model_freight_order_package_item"/>
        <field name="domain_force">['|', ('freight_order_package_id', '=', False), ('freight_order_package_id.freight_operation_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="freight_route_package_company_rule" model="ir.rule">
        <field name="name">Freight Route Package: multi-company</field>

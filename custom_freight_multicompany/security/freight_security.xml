<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="freight_booking_company_rule" model="ir.rule">
        <field name="name">Freight Booking: multi-company</field>
        <field name="model_id" ref="bi_freight_management.model_freight_booking"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="freight_operation_company_rule" model="ir.rule">
        <field name="name">Freight Operation: multi-company</field>
        <field name="model_id" ref="bi_freight_management.model_freight_operation"/>

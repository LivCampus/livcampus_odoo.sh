        <field name="domain_force">['|', ('freight_operation_id', '=', False), ('freight_operation_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="freight_service_company_rule" model="ir.rule">
        <field name="name">Freight Service: multi-company</field>
        <field name="model_id" ref="bi_freight_management.model_freight_service"/>
        <field name="domain_force">['|', ('freight_operation_id', '=', False), ('freight_operation_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="freight_tracking_company_rule" model="ir.rule">
        <field name="name">Freight Tracking: multi-company</field>
        <field name="model_id" ref="bi_freight_management.model_freight_tracking"/>

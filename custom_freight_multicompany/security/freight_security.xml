    </record>
    <record id="freight_booking_line_company_rule" model="ir.rule">
        <field name="name">Freight Booking Line: multi-company</field>
        <field name="model_id" ref="bi_freight_management.model_freight_booking_line"/>
        <field name="domain_force">[('booking_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="freight_order_company_rule" model="ir.rule">
        <field name="name">Freight Order: multi-company</field>
        <field name="model_id" ref="bi_freight_management.model_freight_order"/>
        <field name="domain_force">['|', ('freight_operation_id', '=', False), ('freight_operation_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="freight_order_package_company_rule" model="ir.rule">

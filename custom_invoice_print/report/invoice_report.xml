<odoo>
    <!-- Heredamos DIRECTO el documento de factura (nivel correcto, no account.report_invoice) -->
    <template id="report_invoice_document_custom" inherit_id="account.report_invoice_document">
        <xpath expr="//t[@t-call='web.external_layout']" position="attributes">
            <attribute name="t-if">o.company_id.name != 'KUUCH LOGISTICS MEXICO'</attribute>
        </xpath>
        <xpath expr="//t[@t-call='web.external_layout']" position="before">
            <t t-if="o.company_id.name == 'KUUCH LOGISTICS MEXICO'">
                <!-- ===== TU FORMATO CUSTOM ===== -->
                <t t-set="doc" t-value="o"/>
                <t t-set="context_timestamp" t-value="lambda t: t"/>
                <t t-call="web.internal_layout">
                    <div class="page" style="font-family: sans-serif;">
                        <t t-set="cfdi_values" t-value="doc._l10n_mx_edi_get_extra_invoice_report_values() or {}"/>
                        <style>
                            .incargo-header-bar {
                                background-color: #005a3c !important;
                                color: white !important;
                                font-weight: bold;
                                text-align: center;
                                padding: 5px !important;
                                border: 1px solid #000 !important;
                                text-transform: uppercase;
                                font-size: 12px;
                            }
                            .incargo-label-gray {
                                background-color: #f2f2f2 !important;
                                font-weight: bold;
                                text-align: center;
                                font-size: 12px;
                                padding: 3px !important;
                            }
                            .incargo-content-cell {
                                padding: 5px !important;
                                min-height: 90px;
                                vertical-align: top;
                                font-size: 12px;
                            }
                            .text-red { color: #d9534f; font-weight: bold; }
                            .table-concepts th,
                            .table-concepts {
                                border: none !important;
                            }
                            .table-concepts tr,
                            .table-concepts td,
                            .table-concepts th {
                                border: none !important;
                            }
                            /* ===== Bloque de Sello/Timbre: que nunca se corte entre hojas ===== */
                            .cfdi-stamp-block {
                                page-break-inside: avoid;
                                -webkit-column-break-inside: avoid;
                                break-inside: avoid;
                            }
                            /* Texto de cadenas largas (sello, sello SAT, cadena original):
                               letra pequeña y monoespaciada para que quepan sin desbordar */
                            .cfdi-hash-text {
                                font-size: 7px;
                                font-family: 'Courier New', monospace;
                                line-height: 1.25;
                                overflow-wrap: anywhere;
                                word-wrap: break-word;
                            }
                            /* Estilo compacto para la tabla de totales (usa el template nativo de Odoo) */
                            .table-totals-incargo td {
                                padding: 4px !important;
                                font-size: 12px !important;
                            }
                            .table-totals-incargo tr:not(:last-child) td {
                                background-color: #f2f2f2;
                            }
                            .table-totals-incargo tr:last-child td {
                                background-color: #f2f2f2;
                                font-weight: bold;
                                border-top: 1px solid #000 !important;
                            }
                            /* Nota / descripción adicional debajo del nombre del producto */
                            .concept-note-text {
                                font-size: 10px;
                                color: #555555;
                                white-space: pre-line;
                                line-height: 1.2;
                            }
                        </style>
                        <!-- Encabezado de Factura -->
                        <div class="row g-0 mt-4">
                            <div class="col-12 incargo-header-bar">Factura Electrónica</div>
                        </div>
                        <!-- Bloque Emisor / Receptor / Info Fiscal -->
                        <div class="row g-0 d-flex align-items-stretch">
                            <!-- Columna Izquierda: Emisor y Receptor -->
                            <div class="col-6 d-flex flex-column">
                                <!-- Bloque Emisor -->
                                <div class="incargo-label-gray">Emisor</div>
                                <div class="incargo-content-cell">
                                    <strong t-field="doc.company_id.name"/>
                                    <br/>
                                    <strong>RFC: </strong>
                                    <span t-field="doc.company_id.vat"/>
                                    <br/>
                                    <t t-if="'l10n_mx_edi_fiscal_regime' in doc.company_id">
                                        <strong>Régimen Fiscal: </strong>
                                        <span t-field="doc.company_id.l10n_mx_edi_fiscal_regime"/>
                                    </t>
                                </div>
                                <!-- Bloque Receptor -->
                                <div class="incargo-label-gray">Receptor</div>
                                <div class="incargo-content-cell flex-grow-1">
                                    <strong t-field="doc.partner_id.name"/>
                                    <br/>
                                    <strong>RFC: </strong>
                                    <span t-field="doc.partner_id.vat"/>
                                    <br/>
                                    <strong>Domicilio Fiscal: </strong>
                                    <span t-field="doc.partner_id.zip"/>
                                    <br/>
                                    <strong>Régimen Fiscal: </strong>
                                    <span t-if="doc.partner_id.l10n_mx_edi_fiscal_regime" t-field="doc.partner_id.l10n_mx_edi_fiscal_regime"/>
                                    <span t-else="">No definido</span>
                                    <br/>
                                    <t t-if="'l10n_mx_edi_usage' in doc">
                                        <strong>Uso del CFDI: </strong>
                                        <span t-field="doc.l10n_mx_edi_usage"/>
                                    </t>
                                </div>
                            </div>
                            <!-- Columna Derecha: Información Fiscal -->
                            <div class="col-6 d-flex flex-column">
                                <div class="incargo-label-gray" style="border-top:none !important;">Información Fiscal</div>
                                <div style="padding: 10px; font-size: 12px;" class="flex-grow-1">
                                    <!-- Folio Interno -->
                                    <div class="row g-0">
                                        <div class="col-5">
                                            <strong>Folio</strong>
                                        </div>
                                        <div class="col-7 text-red text-end">
                                            <span t-field="doc.name"/>
                                        </div>
                                    </div>
                                    <!-- UUID -->
                                    <div class="row g-0 mt-2">
                                        <div class="col-5">
                                            <strong>Folio Fiscal (UUID)</strong>
                                        </div>
                                        <div class="col-7 text-end" style="font-size: 8px; word-break: break-all;">
                                            <span t-if="'l10n_mx_edi_cfdi_uuid' in doc" t-field="doc.l10n_mx_edi_cfdi_uuid"/>
                                        </div>
                                    </div>
                                    <!-- Versión -->
                                    <div class="row g-0 mt-1">
                                        <div class="col-6">
                                            <strong>Versión de CFDI</strong>
                                        </div>
                                        <div class="col-6 text-end">4.0</div>
                                    </div>
                                    <!-- Certificado -->
                                    <div class="row g-0 mt-1">
                                        <div class="col-6">
                                            <strong>No. Certificado</strong>
                                        </div>
                                        <div class="col-6 text-end">
                                            <span t-if="cfdi_values" t-out="cfdi_values.get('certificate_number')"/>
                                            <span t-else="" t-field="doc.l10n_mx_edi_certificate_id"/>
                                        </div>
                                    </div>
                                    <div class="row g-0 mt-1">
                                        <div class="col-6">
                                            <strong>Validar CFDI en SAT</strong>
                                        </div>
                                        <div class="col-6 text-end">
                                            <a href="https://verificacfdi.facturaelectronica.sat.gob.mx/" target="_blank" style="color: #217367; text-decoration: underline; font-weight: bold;">
                                                Validar CFDI
                                            </a>
                                        </div>
                                    </div>
                                    <!-- Lugar y Fecha -->
                                    <div class="row g-0 mt-1">
                                        <div class="col-6">
                                            <strong>Lugar y Fecha de Emisión</strong>
                                        </div>
                                        <div class="col-6 text-end">
                                            CP: <span t-field="doc.company_id.zip"/> a
                                            <span t-field="doc.invoice_date"/>
                                        </div>
                                    </div>
                                    <!-- Moneda -->
                                    <div class="row g-0 mt-1">
                                        <div class="col-6">
                                            <strong>Moneda</strong>
                                        </div>
                                        <div class="col-6 text-end">
                                            <span t-if="'currency_id' in doc" t-field="doc.currency_id.name"/>
                                        </div>
                                    </div>
                                    <!-- Forma de Pago -->
                                    <div class="row g-0 mt-1">
                                        <div class="col-6">
                                            <strong>Forma de Pago</strong>
                                        </div>
                                        <div class="col-6 text-end">
                                            <span t-if="'l10n_mx_edi_payment_method_id' in doc" t-field="doc.l10n_mx_edi_payment_method_id.display_name"/>
                                        </div>
                                    </div>
                                    <!-- Método de Pago -->
                                    <div class="row g-0 mt-1">
                                        <div class="col-6">
                                            <strong>Método de Pago</strong>
                                        </div>
                                        <div class="col-6 text-end">
                                            <span t-if="'l10n_mx_edi_payment_policy' in doc" t-field="doc.l10n_mx_edi_payment_policy"/>
                                        </div>
                                    </div>
                                    <!-- Notas al pie de la columna fiscal -->
                                    <div class="mt-auto pt-3">
                                        <div style="font-size: 8px; font-style: italic;">
                                            Este documento es una representación impresa de un CFDI
                                        </div>
                                        <div style="font-size: 8px; font-style: italic;">
                                            Valide este CFDI en https://verificacfdi.facturaelectronica.sat.gob.mx/
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- CONCEPTOS-->
                        <div class="row g-0 mt-3">
                            <div class="col-12 incargo-header-bar" style="padding: 2px !important;">CONCEPTOS</div>
                        </div>
                        <table class="table-concepts" style="width: 100%; font-size: 12px; border-collapse: collapse; margin-top: 5px;">
                            <thead>
                                <tr style="border-bottom: 1px solid #000; background-color: #eee;">
                                    <th class="text-center" style="width: 8%; padding: 3px;">Cantidad</th>
                                    <th class="text-center" style="width: 12%; padding: 3px;">U. Medida</th>
                                    <th class="text-start" style="padding: 3px 0 3px 5px; width: 40%;">Descripción</th>
                                    <th class="text-end" style="padding: 3px 5px 3px 0; width: 15%;">Precio Unitario</th>
                                    <th class="text-center" style="width: 10%; padding: 3px;">Impuesto</th>
                                    <th class="text-end" style="padding: 3px 5px 3px 0; width: 15%;">Importe</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.invoice_line_ids" t-as="line">
                                    <!-- Fila de Producto -->
                                    <t t-if="line.display_type == 'product'">
                                        <tr>
                                            <td class="text-center" style="vertical-align: top; padding-top: 5px;">
                                                <span t-field="line.quantity"/>
                                            </td>
                                            <td class="text-center" style="vertical-align: top; padding-top: 5px;">
                                                <span t-if="line.product_uom_id" t-field="line.product_uom_id.name"/>
                                            </td>
                                            <td style="vertical-align: top; padding: 5px 0 0 5px;">
                                                <!-- Nombre del producto -->
                                                <span t-if="line.product_id" t-field="line.product_id.name"/>
                                                <span t-if="not line.product_id" t-field="line.name" t-options="{'widget': 'text'}" dir="auto"/>
                                                <!-- Nota real: cualquier línea de line.name que NO sea
                                                     exactamente igual al nombre del producto (sin importar
                                                     si va en la línea 1, 2, etc.) -->
                                                <t t-if="line.product_id and line.name">
                                                    <t t-set="note_lines" t-value="[l for l in line.name.split(chr(10)) if l.strip() and l.strip() not in (line.product_id.name.strip(), (line.product_id.display_name or '').strip())]"/>
                                                    <t t-set="note_text" t-value="chr(10).join(note_lines).strip()"/>
                                                    <t t-if="note_text">
                                                        <div class="concept-note-text" style="margin-top: -3px;">
                                                            <t t-out="note_text"/>
                                                        </div>
                                                    </t>
                                                </t>
                                            </td>
                                            <td class="text-end" style="vertical-align: top; padding: 5px 5px 0 0;">
                                                <span t-field="line.price_unit"/>
                                            </td>
                                            <td class="text-center" style="vertical-align: top; padding-top: 5px;">
                                                <t t-foreach="line.tax_ids" t-as="tax">
                                                    <span t-field="tax.name"/>
                                                    <br/>
                                                </t>
                                                <span style="font-size: 7px;">Objeto: 02</span>
                                            </td>
                                            <td class="text-end" style="vertical-align: top; padding: 5px 5px 0 0;">
                                                <span t-field="line.price_subtotal"/>
                                            </td>
                                        </tr>
                                        <!-- Fila SAT (Solo campos básicos) -->
                                        <tr>
                                            <td colspan="6" style="padding: 0 0 5px 10px; font-size: 8px; color: #555;">
                                                <strong>Clave unidad:</strong>
                                                <span t-if="line.product_uom_id and 'unspsc_code_id' in line.product_uom_id and line.product_uom_id.unspsc_code_id" t-field="line.product_uom_id.unspsc_code_id.code"/>
                                                <span t-elif="line.product_uom_id" t-field="line.product_uom_id.name"/>
                                                <strong style="margin-left: 15px;">Clave producto:</strong>
                                                <span t-if="line.product_id" t-field="line.product_id.unspsc_code_id.code"/>
                                            </td>
                                        </tr>
                                    </t>
                                    <t t-elif="line.display_type == 'line_note'">
                                        <tr class="o_line_note">
                                            <td colspan="6">
                                                <span
                                                    t-if="line.name"
                                                    t-field="line.name"
                                                    t-options="{'widget': 'text'}"
                                                    dir="auto"
                                                />
                                            </td>
                                        </tr>
                                    </t>
                                </t>

                            </tbody>
                        </table>
                        <!-- Totales CFDI -->
                        <div class="row g-0 mt-2" style="border: 1px solid #005a3c; font-size: 12px; page-break-inside: avoid;">
                            <!-- Bloque Izquierdo -->
                            <div class="col-8" style="padding: 6px; border-right: 1px solid #005a3c;">
                                <!-- Total con letra -->
                                <div style="font-weight: bold; text-transform: uppercase; margin-top: 10px;">
                                    <span t-out="doc.currency_id.amount_to_text(doc.amount_total)"/>
                                </div>
                                <!-- Tipo de cambio -->
                                <div style="margin-top: 5px;">
                                    <t t-if="doc.currency_id.name != 'MXN'">
                                        Al tipo de cambio
                                        <span t-out="'%.4f' % (1 / doc.invoice_currency_rate)"/>
                                        publicado el
                                        <span t-field="doc.invoice_date"/>
                                        en el DOF
                                        <span style="color:#217367; text-decoration: underline;">
                                            (ver)
                                        </span>
                                    </t>
                                </div>
                            </div>
                            <!-- Bloque Derecho -->
                            <div class="col-4">
                                <table class="table-totals-incargo" style="width: 100%; border-collapse: collapse; font-size: 12px;">
                                    <!-- Usamos el template NATIVO de Odoo para los totales:
                                         desglosa Subtotal, cada grupo de impuesto (IVA 16%, IVA 8%, IEPS, Exento, etc.)
                                         y el Total, leyendo tax_totals con la estructura correcta
                                         sin importar la versión/localización instalada. -->
                                    <t t-if="doc.tax_totals" t-call="account.document_tax_totals">
                                        <t t-set="tax_totals" t-value="dict(doc.tax_totals, display_tax_base=False)"/>
                                        <t t-set="currency" t-value="doc.currency_id"/>
                                    </t>
                                </table>
                            </div>
                        </div>
                        <!--Aqui acaba lo importante -->
                        <!-- ===== SELLO + TIMBRE: solo se muestra si la factura ya está timbrada (tiene UUID) ===== -->
                        <t t-set="cfdi_uuid" t-value="cfdi_values.get('uuid') or doc.l10n_mx_edi_cfdi_uuid"/>
                        <div t-if="cfdi_uuid" class="cfdi-stamp-block">
                            <!-- SELLO DIGITAL -->
                            <div class="row mt-3 g-0 avoid-break">
                                <div class="col-12" style="border:1px dashed #999; padding:6px; font-size: 12px; overflow:hidden; line-height:1.1;">
                                    <strong style="font-size:12px;">
                                        SELLO DIGITAL DEL CONTRIBUYENTE
                                    </strong>
                                    <br/>
                                    <br/>
                                    <div class="cfdi-hash-text">
                                        <t t-out="cfdi_values.get('sello', 'No disponible')"/>
                                    </div>
                                </div>
                            </div>
                            <!-- TIMBRE -->
                            <div class="row mt-2 g-0" style="border:1px solid #000;">
                                <!-- QR -->
                                <div class="col-3 text-center" style="border-right:1px solid #000; padding:5px;">
                                    <t t-if="cfdi_values.get('barcode_src')">
                                        <img t-att-src="cfdi_values['barcode_src']" style="width:110px; height:110px;"/>
                                    </t>
                                </div>
                                <!-- DATOS CFDI -->
                                <div class="col-9" style="font-size: 10px; padding:5px; line-height:1.1; overflow:hidden;">
                                    <div style="font-weight:bold; text-align:center; border-bottom:1px solid #000; margin-bottom:4px; padding-bottom:2px; font-size: 12px;">
                                        TIMBRE FISCAL DIGITAL DEL CFDI
                                    </div>
                                    <strong>Folio Fiscal:</strong>
                                    <span t-out="cfdi_uuid"/>
                                    <br/>
                                    <br/>
                                    <strong>No. Serie Certificado SAT:</strong>
                                    <span t-out="cfdi_values.get('certificate_sat_number') or 'No disponible'"/>
                                    <br/>
                                    <br/>
                                    <strong>Sello SAT:</strong>
                                    <div class="cfdi-hash-text">
                                        <t t-out="cfdi_values.get('sello_sat') or 'No disponible'"/>
                                    </div>
                                    <br/>
                                    <strong>Cadena Original:</strong>
                                    <div class="cfdi-hash-text">
                                        <t t-out="cfdi_values.get('cadena') or 'No disponible'"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!-- ===== NOTAS / TÉRMINOS Y CONDICIONES ===== -->
                        <div t-if="not is_html_empty(doc.narration)" class="mt-3" name="custom_notes" style="font-size: 12px;">
                            <span t-field="doc.narration"/>
                        </div>
                    </div>
                </t>
                <!-- ===== FIN TU FORMATO CUSTOM ===== -->
            </t>
        </xpath>
    </template>
</odoo>
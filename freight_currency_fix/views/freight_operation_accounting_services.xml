<odoo>
    <record id="freight_operation_house_view_form_programing_bill" model="ir.ui.view">
        <field name="name">freight.operation.house.form.programing.bill</field>
        <field name="model">freight.operation</field>
        <field name="inherit_id" ref="bi_freight_management.freight_operation_house_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='accounting']/div[hasclass('table-responsive')]/table/tbody/tr[1]" position="before">
            <tr>
                <td class="table-active">Programming Bill</td>
                <td>
                    <field name="service_sale_total" nolabel="1"/>
                </td>
                <td>
                <field name="service_cost_total" nolabel="1"/>
                </td>
                <td>
                <field name="service_margin_total" nolabel="1"/>
                </td>
            </tr>
            </xpath>
        </field>
    </record>
</odoo>